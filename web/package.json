{
  "name": "dalka-jobs-web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test:unit": "node --experimental-strip-types --test tests/job-search.test.ts tests/job-detail.test.ts tests/ui-foundation.test.ts tests/prototype.test.ts tests/api-client.test.ts tests/frontend-demo.test.ts tests/session-coordinator.test.ts",
    "test:prototype-http": "node --experimental-strip-types tests/prototype-http.ts",
    "test:frontend-http": "node --experimental-strip-types tests/frontend-http.ts",
    "test:live-http": "node --experimental-strip-types tests/live-http.ts",
    "check:dependencies": "npm ls --all"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.31",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
